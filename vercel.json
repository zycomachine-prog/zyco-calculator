{
  "redirects": [
    {
      "source": "/",
      "destination": "/engineering-tools/press-brake-calculator",
      "permanent": true
    },
    {
      "source": "/engineering",
      "destination": "/engineering-tools",
      "permanent": true
    },
    {
      "source": "/engineering/:path*",
      "destination": "/engineering-tools/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
